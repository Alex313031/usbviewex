# Set default behavior to automatically normalize line endings.
* text=auto
*.c text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cc text eol=lf
*.cxx text eol=lf
*.cpp text eol=lf
*.idl text eol=lf
*.def text eol=lf
*.asm text eol=crlf
*.json text eol=lf
*.js text eol=lf
*.ts text eol=lf

# .chm files
*.chm text eol=crlf
*.htm text eol=crlf
*.html text eol=crlf
*.hhc text eol=crlf
*.hhk text eol=crlf
*.hhp text eol=crlf

# Build system Files
*.py text
*.gn text
*.gni text
*.gyp text
*.gypi text
*.mak text eol=lf
*.diff text eol=lf
*.patch text eol=lf

# Keep scripts correct
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.rc text eol=crlf

# Other stuff
/assets/*.txt eol=crlf
*.iss eol=crlf
*.inf eol=crlf
*.dlg eol=crlf
