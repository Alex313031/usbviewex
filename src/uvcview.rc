#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "version.h"

//////////////////////////////////////////////////////////////////////////////
//
// MANIFEST
//
// Embedded manifest: opts in to Common Controls v6 (themed controls) and
// declares the asInvoker execution level
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "usbview.manifest"

//////////////////////////////////////////////////////////////////////////////
//
// ICON
//
IDI_ICON                ICON    DISCARDABLE     "res/usb.ico"
IDI_BADICON             ICON    DISCARDABLE     "res/bang.ico"
IDI_COMPUTER            ICON    DISCARDABLE     "res/sysdm.ico"
IDI_HUB                 ICON    DISCARDABLE     "res/hub.ico"
IDI_NODEVICE            ICON    DISCARDABLE     "res/port.ico"
IDI_NOSSDEVICE          ICON    DISCARDABLE     "res/ssport.ico"
IDI_SSICON              ICON    DISCARDABLE     "res/ssusb.ico"
IDI_SMALL               ICON    DISCARDABLE     "res/small.ico"

//////////////////////////////////////////////////////////////////////////////
//
// Cursor
//
IDC_SPLIT               CURSOR  DISCARDABLE     "res/split.cur"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_MAINDIALOG DIALOGEX 0, 0, 640, 350
STYLE WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU |
    WS_THICKFRAME
CAPTION ABOUT_NAME
MENU IDR_MENU
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL         "Tree1",IDC_TREE,"SysTreeView32",TVS_HASBUTTONS |
                    TVS_HASLINES | TVS_LINESATROOT | WS_BORDER | WS_TABSTOP,
                    0,0,320,341,WS_EX_CLIENTEDGE
    EDITTEXT        IDC_EDIT,320,0,320,341,ES_MULTILINE | ES_READONLY |
                    WS_VSCROLL | WS_HSCROLL
    CONTROL         "Devices Connected: 0",IDC_STATUS,"msctls_statusbar32",
                    SBARS_SIZEGRIP,
                    0,342,640,8
END


IDD_ABOUT DIALOG DISCARDABLE  21, 12, 220, 76
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ABOUT_TITLE
FONT 8, "MS Shell Dlg"
BEGIN
    // The OK button comes first so that it, not the version text, gets the
    // keyboard focus when the dialog opens. An edit control that receives the
    // initial focus selects (highlights) all of its text.
    DEFPUSHBUTTON   "OK",            IDOK,           164, 54, 40, 14
    ICON            IDI_ICON,        IDC_STATIC,     12, 12, 20, 20
    EDITTEXT        IDC_VERSION,                     46, 12, 162, 8, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           ABOUT_COPYRIGHT, IDC_STATIC,     46, 24, 162, 8
    EDITTEXT        IDC_UVCVERSION,                  46, 36, 162, 8, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MENU MENU DISCARDABLE
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Refresh\tF5",        ID_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "Save Current &View ...",       ID_SAVE
        MENUITEM "Save As (&txt) ...",      ID_SAVEALL
        MENUITEM SEPARATOR

        MENUITEM "E&xit",         ID_EXIT
    END
    POPUP "&Options"
    BEGIN
        MENUITEM "&Auto Refresh",                   ID_AUTO_REFRESH, CHECKED
        MENUITEM "Show &Config Descriptors",        ID_CONFIG_DESCRIPTORS, CHECKED
        MENUITEM SEPARATOR
//      MENUITEM "&Show Description Annotations",   ID_ANNOTATION, CHECKED
        MENUITEM "&Log to debugger",                ID_LOG_DEBUG
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Help",                       IDM_HELP
        MENUITEM "&About",                      ID_ABOUT
    END
END

//////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDACCEL ACCELERATORS DISCARDABLE
BEGIN
    VK_F5,          ID_REFRESH,            VIRTKEY,NOINVERT       // "F5"
    "?",            ID_ABOUT,              ASCII,ALT              // "Alt+?"
    VK_OEM_2,       ID_ABOUT,              VIRTKEY,ALT            // "Alt+/"
    VK_ESCAPE,      ID_EXIT,               VIRTKEY,NOINVERT       // "Esc"
END

/////////////////////////////////////////////////////////////////////////////
//
// String Table
//

STRINGTABLE 
BEGIN
    IDS_STRINGBASE              "Base string"
END

STRINGTABLE 
BEGIN
    IDS_STANDARD_FONT           "Courier"
    IDS_STANDARD_FONT_HEIGHT    "\13"
    IDS_STANDARD_FONT_WIDTH     "\10"
END

STRINGTABLE DISCARDABLE
BEGIN
    IDS_USBVIEW_USAGE               "usbview usage:\nusbview [/?]\n\t/? - this usage message.\
                                    \n\t/q quiet mode, does not display 'Press any key to continue ...\n\t\
                                    \nusbview [/q] [/f] /saveall:<filename.txt>\
                                    \n\tsaveall - saves the USB tree view as a text file\
                                    \n\t/f - overwrite file if it already exists\n\n"
    IDS_USBVIEW_PRESSKEY            "Press any key to continue ...\n"
    IDS_USBVIEW_INVALIDARG          "Invalid argument: [%1]\n"
    IDS_USBVIEW_FILE_EXISTS_TXT     "File: [%1] already exists, try `usbview /f /saveall:[%1]` to force overwrite\n"
    IDS_USBVIEW_INTERNAL_ERROR      "An internal error occured, please report this as a bug\n"
    IDS_USBVIEW_SAVED_TO            "Usbview information saved to file : [%1]\n"
    IDS_USBVIEW_INVALID_FILENAME    "The argument : [%1] is invalid or incomplete.\n"
END

//////////////////////////////////////////////////////////////////////////////
//
// VERSION
//
#define VER_FILEDESCRIPTION_STR     "Microsoft\256 Windows(TM) USB device viewer"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION USBVIEW_MAJOR_VERSION, USBVIEW_MINOR_VERSION, USBVIEW_BUILD_VERSION, 0
 PRODUCTVERSION USBVIEW_MAJOR_VERSION, USBVIEW_MINOR_VERSION, USBVIEW_BUILD_VERSION, 0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG // 0x00000001L
#else // Release mode
 FILEFLAGS 0x00000000L
#endif  // _DEBUG
 FILEOS VOS_NT_WINDOWS32 // 0x00040004L
 FILETYPE VFT_APP // 0x00000001L
 FILESUBTYPE VFT2_UNKNOWN // 0x00000000L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0" // English Unicode
        BEGIN
            VALUE "Comments", "https://github.com/Alex313031/usbviewex"
            VALUE "CompanyName", "Alex313031"
            VALUE "FileDescription", VER_FILEDESCRIPTION_STR
            VALUE "FileVersion", VERSION_STRING
            VALUE "InternalName", "usbview"
            VALUE "LegalCopyright", LEGAL_COPYRIGHT
            VALUE "LegalTrademarks", "MS-PL"
            VALUE "OriginalFilename", "usbview.exe"
            VALUE "ProductName", "USBViewEx"
            VALUE "ProductVersion", VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
